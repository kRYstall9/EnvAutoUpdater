#SERVICE_ENV_PATH=/path/to/local/env
#SERVICE_ENV_REPO_URL=/path/to/remote/env/repo.git -> FOR EXAMPLE: https://raw.githubusercontent.com/user/repo/refs/heads/main/.env-sample


SERVICE1_ENV_PATH=/path/to/local/env
SERVICE1_ENV_REPO_URL=/path/to/remote/env/repo.git 

SERVICE2_ENV_PATH=/path/to/local/env2
SERVICE2_ENV_REPO_URL=/path/to/remote/env2/repo.git 

## Optional: Set the log level (e.g., debug, info, warning, error)
LOG_LEVEL = info [default: info]

CHECK_INTERVAL = 3600 # Interval between checks for updates (in seconds) [default: 3600 seconds = 1 hour]

SAVE_BACKUP_FILE = true # Set to true to save backup files before updating [default: true]

TZ=UTC # Set the timezone for logging (e.g., UTC, America/New_York) [default: UTC]